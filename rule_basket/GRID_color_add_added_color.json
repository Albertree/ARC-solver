{
    "id": "color_diff_rule",
    "name": "add_color_when_diff_detected",
    "parameter": {
        "color_value": {
            "type": "integer",
            "range": [0, 9]
        }
    },
    "condition": {
        "operand1": {
            "operand1": "result.category.color.type",
            "operator": "==",
            "operand2": "DIFF"
        },
        "operator": "AND",
        "operand2": {
            "operand1": "result.category.color.category.{color_value}.comp2",
            "operator": "==",
            "operand2": "True"
        }
    },
    "action": {
        "name": "add_added_color",
        "args": {
            "colorlist": "added_color",
            "color": "{color_value}"
        }
    }
}
