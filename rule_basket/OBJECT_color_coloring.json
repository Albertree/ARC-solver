{
    "id": "rule_id",
    "name": "rule_name",
    "parameter": {
        "color_value": {
            "type": "integer",
            "range": [0, 9]
        }
    },
    "condition": {
        "operand1": {
            "operand1": {
                "operand1": "result.category.color.type",
                "operator": "==",
                "operand2": "DIFF"
            },
            "operator": "AND",
            "operand2": {
                "operand1": "result.score",
                "operator": "==",
                "operand2": "7/8"
            }
        },
        "operator": "AND",
        "operand2": {
            "operand1": "result.category.color.category.{color_value}.comp2",
            "operator": "!=",
            "operand2": false
        }
    },
    "action": {
        "name": "coloring",
        "args": {
            "selection": "result.category.coordinate.comp2",
            "color": "{color_value}"
        }
    }
}

